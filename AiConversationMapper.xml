<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.AiConversationMapper">

    <resultMap type="AiConversation" id="AiConversationResult">
        <result property="conversationId"    column="conversation_id"    />
        <result property="title"             column="title"              />
        <result property="conversationType"  column="conversation_type"  />
        <result property="userId"            column="user_id"            />
        <result property="isPinned"          column="is_pinned"          />
        <result property="pinnedTime"        column="pinned_time"        />
        <result property="lastMessage"       column="last_message"       />
        <result property="lastMessageTime"   column="last_message_time"  />
        <result property="status"            column="status"             />
        <result property="createBy"          column="create_by"          />
        <result property="createTime"        column="create_time"        />
        <result property="updateBy"          column="update_by"          />
        <result property="updateTime"        column="update_time"        />
        <result property="remark"            column="remark"             />
    </resultMap>

    <sql id="selectConversationVo">
        select conversation_id, title, conversation_type, user_id, is_pinned, pinned_time,
               last_message, last_message_time, status, create_by, create_time, update_by, update_time, remark
        from ai_conversation
    </sql>

    <select id="selectConversationById" parameterType="Long" resultMap="AiConversationResult">
        <include refid="selectConversationVo"/>
        where conversation_id = #{conversationId}
    </select>

    <select id="selectConversationList" parameterType="AiConversation" resultMap="AiConversationResult">
        <include refid="selectConversationVo"/>
        <where>
            status = '0'
            <if test="userId != null"> AND user_id = #{userId}</if>
            <if test="title != null and title != ''"> AND title like concat('%', #{title}, '%')</if>
            <if test="conversationType != null and conversationType != ''"> AND conversation_type = #{conversationType}</if>
        </where>
        order by last_message_time desc, update_time desc, create_time desc
    </select>

    <select id="selectConversationListByUserId" parameterType="Long" resultMap="AiConversationResult">
        <include refid="selectConversationVo"/>
        where user_id = #{userId} and status = '0'
        order by last_message_time desc, update_time desc, create_time desc
        limit 20
    </select>

    <select id="countPinnedByUserId" parameterType="Long" resultType="int">
        select count(1) from ai_conversation where user_id = #{userId} and is_pinned = '1' and status = '0'
    </select>

    <insert id="insertConversation" parameterType="AiConversation" useGeneratedKeys="true" keyProperty="conversationId">
        insert into ai_conversation
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="title != null and title != ''">title,</if>
            <if test="conversationType != null and conversationType != ''">conversation_type,</if>
            <if test="userId != null">user_id,</if>
            <if test="isPinned != null">is_pinned,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="title != null and title != ''">#{title},</if>
            <if test="conversationType != null and conversationType != ''">#{conversationType},</if>
            <if test="userId != null">#{userId},</if>
            <if test="isPinned != null">#{isPinned},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateConversation" parameterType="AiConversation">
        update ai_conversation
        <trim prefix="SET" suffixOverrides=",">
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="conversationType != null">conversation_type = #{conversationType},</if>
            <if test="isPinned != null">is_pinned = #{isPinned},</if>
            <if test="pinnedTime != null">pinned_time = #{pinnedTime},</if>
            <if test="lastMessage != null">last_message = #{lastMessage},</if>
            <if test="lastMessageTime != null">last_message_time = #{lastMessageTime},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where conversation_id = #{conversationId}
    </update>

    <update id="updateLastMessage" parameterType="AiConversation">
        update ai_conversation
        set last_message = #{lastMessage}, last_message_time = #{lastMessageTime}, update_time = #{updateTime}
        where conversation_id = #{conversationId}
    </update>

    <update id="updatePinned">
        update ai_conversation set is_pinned = #{param2},
        <choose>
            <when test="param2 == '1'">pinned_time = sysdate()</when>
            <otherwise>pinned_time = null</otherwise>
        </choose>
        where conversation_id = #{param1}
    </update>

    <delete id="deleteConversationById" parameterType="Long">
        update ai_conversation set status = '1' where conversation_id = #{conversationId}
    </delete>

    <delete id="deleteConversationByIds" parameterType="Long">
        update ai_conversation set status = '1' where conversation_id in
        <foreach item="conversationId" collection="array" open="(" separator="," close=")">
            #{conversationId}
        </foreach>
    </delete>
</mapper>
